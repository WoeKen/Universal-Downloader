{
  "manifest_version": 3,
  "name": "全能下载器 - 浏览器极速接管扩展",
  "version": "1.0.0",
  "description": "一键将网页视频、音频、文件与磁力链接发送至全能下载器桌面端进行多线程极速加速下载。",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "contextMenus",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "全能下载器 (Universal Downloader)"
  }
}
